# =========================================================================
# WordCourt environment variables
# Copy this file to .env (root) and apps/web/.env.local, then fill in values.
# NEVER commit a filled .env. Only this .example file is tracked.
# =========================================================================

# --- App ---
NEXT_PUBLIC_APP_NAME=WordCourt
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- GenLayer (StudioNet) ---
# Filled in after you deploy the Intelligent Contract and give me the address.
NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=
# Browser clients call the same-origin proxy below; keep the upstream RPC server-side.
NEXT_PUBLIC_GENLAYER_RPC_PROXY_URL=/api/genlayer/rpc
GENLAYER_RPC_URL=https://studio.genlayer.com/api
# Backwards-compatible fallback for older deployments. Prefer GENLAYER_RPC_URL.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=https://explorer-studio.genlayer.com

# Server-side GenLayer operator key (for service-role contract reads/sync only).
# Used by API routes / sync workers. Keep secret.
GENLAYER_OPERATOR_PRIVATE_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only. Used by Edge Functions and privileged API routes
# (tile bag, racks, official_state writes). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to build tile-bag and rack commitments (hash salt). Server-only.
TILE_COMMITMENT_SECRET=

# --- Wallet / RainbowKit ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Wallet auth (Sign-In With Ethereum) ---
# Secret for signing the Supabase-compatible session JWT after SIWE verification.
SIWE_JWT_SECRET=
SIWE_SESSION_TTL_SECONDS=86400

# --- Rate limiting (optional Upstash; falls back to in-memory in dev) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability / analytics (optional, no-op when blank) ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_KEY=
LOG_LEVEL=info
